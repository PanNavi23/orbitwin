# Build outputs. SHA256SUMS.txt is generated by scripts/build_release.py at
# packaging time and shipped inside the archive; a copy committed here can only
# be accurate for the one commit that produced it, and a stale integrity
# manifest is worse than none.
/SHA256SUMS.txt
# Written into the archive the same way, naming its commit; build_release.py
# removes it again, and the committed one named none.
/BUILD_INFO.json
/output/
# What the day and the runbook's steps write: day folders, certify's runs, the upload.
/run/
# The day's inputs, copied in by RUNBOOK step 1; only the note is tracked.
/input/original/*
!/input/original/README.md
/build/
/dist/
*.egg-info/

# Caches and coverage
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Local environments
.venv/

# The wheel bundle is 277 MB of third-party binaries. It is fetched by
# scripts/fetch_offline_wheels.sh and carried to the competition machine, not
# committed -- the same reasoning vendor/gmat/README.md gives for GMAT itself.
# SHA256SUMS.txt is committed, so a carried bundle can be checked against the
# one that was validated.
vendor/wheels/*.whl
# What fetch_offline_wheels.sh downloads into before it replaces the bundle.
vendor/.wheels-staging.*/

# Material handed to the project rather than produced by it: the mutation
# corpus, a release archive, GMAT's own log. Untracked and ignored, so that
# `git stash -u` leaves them alone -- it took them twice, and the second time
# they were only recoverable because the stash still existed.
/mutation corpus/
/tasa_orbitwin-*.zip
/GmatLog.txt

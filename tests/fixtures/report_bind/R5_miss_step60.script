Propagate DefaultProp(SC_Alien, SC_Human) {SC_Alien.ElapsedSecs = 0.0010010012192320022, SC_Human.ElapsedSecs = 0.0010010012192320022};
Maneuver ImpulsiveBurn1(SC_Human);
